# ห้าม commit ไฟล์ .env จริง — เก็บใน secret manager
PORT=3000
BASE_URL=https://pay.example-municipality.go.th
# มี DATABASE_URL = ใช้ PostgreSQL / ไม่มี = ใช้ฐานข้อมูลในตัว (PGlite) ที่โฟลเดอร์ DATA_DIR
DATABASE_URL=
DATA_DIR=./data
# ผู้ดูแลคนแรก (ใช้ตอนเริ่มระบบครั้งแรกเท่านั้น)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# openssl rand -hex 32  (ห้ามเปลี่ยนหลังมีข้อมูล — ใช้ถอดรหัสชื่อ/เบอร์โทร)
DATA_KEY=
RECEIPT_SECRET=
# Biller ID 15 หลัก จากธนาคาร (เลขผู้เสียภาษี 13 + suffix 2)
BILLER_ID=
BANK_CALLBACK_SECRET=
BANK_ALLOWED_IPS=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
TRUST_PROXY=loopback
